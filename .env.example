# Supabase 프로젝트 설정 (supabase.com → Project Settings → API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 파일 업로드가 Vercel을 거치지 않고 Supabase Storage로 직접 올라가게 하는 데 필요 (공개해도 되는 키)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Google Cloud Console → OAuth 2.0 클라이언트 ID (웹 애플리케이션)
GOOGLE_CLIENT_ID=

# 자체 세션 토큰 서명용 비밀키 (예: openssl rand -hex 32)
JWT_SECRET=

# 프론트엔드에서 Google 로그인 버튼을 띄우는 데 필요 (GOOGLE_CLIENT_ID와 같은 값)
VITE_GOOGLE_CLIENT_ID=
